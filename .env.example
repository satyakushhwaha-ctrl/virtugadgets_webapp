SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
PUBLIC_DOMAINS=virtugadgets.in,www.virtugadgets.in

# Local Redis/Celery broker and result backend. Railway supplies REDIS_URL.
REDIS_URL=redis://127.0.0.1:6379/0
# Railway should set this to true; set false only for a local X-server/Xvfb.
PLAYWRIGHT_HEADLESS=true

# Amazon search provider: auto (Playwright, then ScrapingBee fallback),
# playwright, or scrapingbee. Never commit the real API key.
AMAZON_SEARCH_PROVIDER=auto
SCRAPINGBEE_API_KEY=1EET3JHB8CJR7P03IW5ULWQK7FT70S3DZEJCF34O9KJ1IRYRXFV3Y9YNU1R18A9PT13WRS1CGE8YYXPJ

DB_NAME=virtugadget
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

TIME_ZONE=UTC
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
